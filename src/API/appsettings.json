{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SkillsetsBackendDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "SkillsetsBackend",
    "Audience": "SkillsetsBackend.Client",
    "Secret": "REPLACE_WITH_A_STRONG_SECRET_STORED_IN_USER_SECRETS_OR_KEY_VAULT",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
